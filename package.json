  "description": "IDENTIFY THE BRAND — a fast-paced fragmented-logo recognition game. Node/Express + CSV/Google Sheets persistence.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
