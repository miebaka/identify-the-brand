{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run validate:logos",
  "functions": {
    "api/index.js": {
      "includeFiles": "public/assets/logos/**",
      "maxDuration": 60
    },
    "api/[...path].js": {
      "includeFiles": "public/assets/logos/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
