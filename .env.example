# Copy to .env and fill in real values. NEVER commit .env.

# Port the server listens on.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Admin credentials. The dashboard and all export routes require these.
# Use a long, random password. Do NOT reuse a password from elsewhere.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Secret used to sign admin session tokens (any long random string).
ADMIN_TOKEN_SECRET=change-me-to-another-long-random-string

# Directory for CSV persistence. Must be on PERSISTENT storage in production.
DATA_DIR=./data

# Retention window advertised in the privacy notice (days).
RETENTION_DAYS=90

# Set to 1 to trust a reverse proxy (Railway/Render) for correct client IPs
# used only by rate limiting. No IPs are written to gameplay CSV.
TRUST_PROXY=0
