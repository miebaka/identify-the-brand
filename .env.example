# Copy to .env and fill in real values. NEVER commit .env.

# Port the server listens on.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Admin credentials. The dashboard and all export routes require these.
# Use a long, random password. Do NOT reuse a password from elsewhere.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Secret used to sign admin session tokens (any long random string).
ADMIN_TOKEN_SECRET=change-me-to-another-long-random-string

# Directory for CSV persistence. Must be on PERSISTENT storage in production.
DATA_DIR=./data

# Retention window advertised in the privacy notice (days).
RETENTION_DAYS=90

# Set to 1 to trust a reverse proxy for correct client IPs
# used only by rate limiting. No IPs are written to gameplay CSV.
TRUST_PROXY=0

# --- Optional: Google Sheets backend (see SHEETS.md) ---
# When BOTH are set, gameplay records are written to a Google Sheet via an
# Apps Script webhook and the leaderboard/exports read from it — no persistent
# disk required (great for free-tier hosting). Leave blank to use local CSV.
SHEETS_WEBHOOK_URL=
SHEETS_SECRET=

# Optional: keep the read-only logo registry on a fixed path if you mount a
# writable disk over ./data. Defaults to <repo>/data/logos.json.
# LOGOS_FILE=./data/logos.json
